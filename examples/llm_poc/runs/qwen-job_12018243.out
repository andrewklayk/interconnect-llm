```python
import os

def read_user_file(db, username, filename):
    cursor = db.cursor()
    cursor.execute("SELECT id FROM users WHERE name = ?", (username,))
    user_id = cursor.fetchone()
    
    if user_id:
        full_path = os.path.join('/srv/files', filename)
        if os.path.abspath(full_path).startswith(os.path.abspath('/srv/files')):
            try:
                with open(full_path, 'r') as file:
                    return file.read()
            except FileNotFoundError:
                return None
    return None
```

